nextflow_pipeline {

    options "-stub-run"

    name "Test sf-pediatric profile tracking"
    script "../main.nf"

    test("Tracking profile - should run successfully") {

        when {
            params {

                params.input = "$projectDir/tests/data/bids/"
                params.outdir = "$outputDir"

                params.dti_max_shell_value = 1500

                params.tracking = true
                params.run_freewater = true
            }
        }

        then {
            // stable name: All files + folders in ${params.outdir}/ with a stable name.
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore:  ['pipeline_info/*.{html,json,txt}'])
            assertAll {
                assert workflow.success
                assert snapshot(
                    // Number of successfully completed tasks
                    workflow.trace.succeeded().size(),
                    // Remove the nextflow version from the versions.yml because we test it using different nextflow versions.
                    removeNextflowVersion("$outputDir/pipeline_info/sf_pediatric_software_mqc_versions.yml"),
                    // All stable name.
                    stable_name
                ).match()
            }
        }
    }

    test("Tracking profile no dwi preprocessing - should run successfully") {

        when {
            params {

                params.input = "$projectDir/tests/data/bids/"
                params.outdir = "$outputDir"

                params.dti_max_shell_value = 1500

                params.tracking = true
                params.run_dwi_denoising = false
                params.run_dwi_degibbs = false
                params.run_dwi_topup = false
                params.run_dwi_eddy = false
                params.run_dwi_n4 = false
            }
        }

        then {
            // stable name: All files + folders in ${params.outdir}/ with a stable name.
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore:  ['pipeline_info/*.{html,json,txt}'])
            assertAll {
                assert workflow.success
                assert snapshot(
                    // Number of successfully completed tasks
                    workflow.trace.succeeded().size(),
                    // Remove the nextflow version from the versions.yml because we test it using different nextflow versions.
                    removeNextflowVersion("$outputDir/pipeline_info/sf_pediatric_software_mqc_versions.yml"),
                    // All stable name.
                    stable_name
                ).match()
            }
        }
    }

    test("Tracking profile without participants.tsv file - should fail") {

        when {
            params {

                params.input = "$projectDir/tests/data/noparticipantfile/"
                params.outdir = "$outputDir"

                params.tracking = true

            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.contains("ERROR: Your bids dataset does not contain a participants.tsv file. Please provide a participants.tsv file with a column indicating the participants' age. For any questions, please refer to the documentation at https://scilus.github.io/sf-pediatric/ or open an issue!")
        }
    }

    test("Tracking profile with wrong participants.tsv file - should fail") {

        when {
            params {

                params.input = "$projectDir/tests/data/wrongparticipantfile/"
                params.outdir = "$outputDir"

                params.tracking = true

            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.contains("ERROR: Age not found for participant sub-test1 in participants.tsv file. Please validate.")
        }
    }

    test("Tracking profile with wrong DTI b-values thresholds - should fail") {

        when {
            params {

                params.input = "$projectDir/tests/data/bids/"
                params.outdir = "$outputDir"

                params.tracking = true

            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.contains("ERROR: No b-values are below the dti_max_shell_value threshold of 1200 for subject sub-test1. Current protocol (excluding b0s) contains the following shells: 1500.0, 2000.0. Please check your acquisition protocol and provide the shells to use for DTI fitting using --dti_shells. Alternatively, you can increase this threshold using --dti_max_shell_value.")
        }
    }

    test("Tracking profile with wrong fODF b-values thresholds - should fail") {

        when {
            params {

                params.input = "$projectDir/tests/data/bids/"
                params.outdir = "$outputDir"

                params.fodf_min_shell_value = 2500
                params.dti_max_shell_value = 1500

                params.tracking = true
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.contains("ERROR: No b-values are above the fodf_min_shell_value threshold of 2500 for subject sub-test1. Current protocol (excluding b0s) contains the following shells: 1500.0, 2000.0. Please check your acquisition protocol and provide the shells to use for fODF fitting using --fodf_shells. Alternatively, you can decrease this threshold using --fodf_min_shell_value.")
        }
    }
}
