/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    scilus/sf_pediatric Nextflow GPU config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {
    // ** Eddy-related changes for GPU execution ** //
    withName: PREPROC_EDDY {
        accelerator = 1
        clusterOptions = { "--gres=gpu:1" }
        cpus = 1
        memory = 4.GB
        time = 4.h
        ext.eddy_cmd = "eddy"
    }

    // ** Local tracking changes for GPU execution ** //
    withName: TRACKING_LOCALTRACKING {
        accelerator = 1
        clusterOptions = { "--gres=gpu:1" }
        cpus = 1
        memory = 4.GB
        time = 4.h
        ext.gpu_batch_size = 10000
        ext.enable_gpu = true
    }

    // ** Synthstrip changes for GPU execution ** //
    withName: BETCROP_SYNTHSTRIP {
        accelerator = 1
        clusterOptions = { "--gres=gpu:1" }
        cpus = 1
        memory = 4.GB
        time = 4.h
        ext.gpu = true
    }
}
