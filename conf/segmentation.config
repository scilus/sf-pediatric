/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    //** SEGMENTATION **//
    withName: '.*:SEGMENTATION:FASTSURFER' {
        ext.acq3T = params.acq3T
        ext.cerebnet = params.cerebnet
        ext.hypvinn = params.hypvinn
        ext.seg_only = false
    }

    // ** Nothing to set here ** //
    // withName: '.*:SEGMENTATION:RECONALLCLINICAL' {
    // }

    // ** Nothing to set here ** //
    // withName: '.*:SEGMENTATION:RECONALL' {
    // }

    // ** Nothing to set here ** //
    // withName: '.*:SEGMENTATION:BIBSNET' {
    // }

    withName: '.*:SEGMENTATION:INFANTFS' {
        ext.newborn = true
        ext.oneyear = false
        ext.forceskullstrip = false
        ext.mi = false
        ext.gmwm = false
        ext.ccseg = false
        ext.nostats = false
        ext.intnormFSL = false
    }

    withName: '.*:SEGMENTATION:REGISTRATION_ANTSREGISTRATION' {
        ext.dimension = 3
        ext.transform = "s"
        ext.interpolation = "Linear"
    }

    withName: '.*:SEGMENTATION:REGISTRATION_ANTSAPPLYTRANSFORMS' {
        ext.dimensionality = 3
        ext.image_type = 0
        ext.interpolation = "NearestNeighbor"
        ext.output_dtype = "int"
    }

    // ** Nothing to set here ** //
    // withName: '.*:SEGMENTATION:ATLASES_FSLR2FSAVERAGE' {
    // }

    withName: '.*:SEGMENTATION:ATLASES_FSAVERAGE2SUBJECT' {
        publishDir = [
            path: { params.outdir },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def ses = meta.session ? "_${meta.session}" : ""
                def run = meta.run ? "_run-${meta.run}" : ""
                def anat_dir = meta.session ? "${meta.id}/${meta.session}/anat" : "${meta.id}/anat"
                def fs_dir = params.fs_output_dir ?: "../freesurfer"

                if ( filename.contains("_fs") ) { "${fs_dir}/${meta.id}${ses}${run}" }
                else if ( filename.contains("dseg.nii.gz") ) { "${anat_dir}/${meta.id}${ses}${run}_seg-${params.atlas_name}_dseg.nii.gz" }
                else if ( filename.contains("volume_subcortical") ) { "${anat_dir}/${meta.id}${ses}${run}_seg-${params.atlas_name}_stat-subcortical.tsv" }
                else if ( filename.contains("volume_lh") ) { "${anat_dir}/${meta.id}${ses}${run}_seg-${params.atlas_name}_hemi-left_stat-volume.tsv" }
                else if ( filename.contains("volume_rh") ) { "${anat_dir}/${meta.id}${ses}${run}_seg-${params.atlas_name}_hemi-right_stat-volume.tsv" }
                else if ( filename.contains("area_lh") ) { "${anat_dir}/${meta.id}${ses}${run}_seg-${params.atlas_name}_hemi-left_stat-surfacearea.tsv" }
                else if ( filename.contains("area_rh") ) { "${anat_dir}/${meta.id}${ses}${run}_seg-${params.atlas_name}_hemi-right_stat-surfacearea.tsv" }
                else if ( filename.contains("thickness_lh") ) { "${anat_dir}/${meta.id}${ses}${run}_seg-${params.atlas_name}_hemi-left_stat-thickness.tsv" }
                else if ( filename.contains("thickness_rh") ) { "${anat_dir}/${meta.id}${ses}${run}_seg-${params.atlas_name}_hemi-right_stat-thickness.tsv" }
                else if ( filename.contains("dseg.tsv") ) { "${anat_dir}/${meta.id}${ses}${run}_seg-${params.atlas_name}_desc-labels_dseg.tsv" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.lean_output ? null : filename }
            }
        ]
    }
}
