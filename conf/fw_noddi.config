/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    withName: ".*:RECONST_FW_NODDI:RECONST_FREEWATER" {
        ext.lambda1 = params.freewater_lambda1
        ext.lambda2 = params.freewater_lambda2
        ext.replace_bad_voxels = 0
        ext.b_thr = params.dwi_b0_threshold
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def ses = meta.session ? "${meta.session}_" : ""
                if ( filename.contains("fwf.nii.gz") ) { "${meta.id}_${ses}model-fw_param-fwf_dwimap.nii.gz" }
                else if ( filename.contains("dir.nii.gz") ) { "${meta.id}_${ses}model-fw_param-direction_dwimap.nii.gz" }
                else if ( filename.contains("fibervolume.nii.gz") ) { "${meta.id}_${ses}model-fw_param-fibervolume_dwimap.nii.gz" }
                else if ( filename.contains("dwi_fw_corrected.nii.gz") ) { "${meta.id}_${ses}desc-fwc_dwi.nii.gz" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.lean_output ? null : filename }
            }
        ]
    }

    withName: ".*:RECONST_FW_NODDI:RECONST_NODDI" {
        ext.lambda1 = params.noddi_lambda1
        ext.lambda2 = params.noddi_lambda2
        ext.replace_bad_voxels = 0
        ext.b_thr = params.dwi_b0_threshold
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def ses = meta.session ? "${meta.session}_" : ""
                if ( filename.contains("icvf.nii.gz") ) { "${meta.id}_${ses}model-noddi_param-icvf_dwimap.nii.gz" }
                else if ( filename.contains("odi.nii.gz") ) { "${meta.id}_${ses}model-noddi_param-odi_dwimap.nii.gz" }
                else if ( filename.contains("isovf.nii.gz") ) { "${meta.id}_${ses}model-noddi_param-isovf_dwimap.nii.gz" }
                else if ( filename.contains("dir.nii.gz") ) { "${meta.id}_${ses}model-noddi_param-direction_dwimap.nii.gz" }
                else if ( filename.contains("ecvf.nii.gz") ) { "${meta.id}_${ses}model-noddi_param-ecvf_dwimap.nii.gz" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.lean_output ? null : filename }
            }
        ]
    }

    withName: ".*:RECONST_FW_NODDI:FW_CORRECTED_DTIMETRICS" {
        ext.prefix = { [meta.id, meta.session?: "", "desc-fwc"].findAll { x -> x }.join("_") }
        ext.dwi_shell_tolerance = params.dwi_shell_tolerance
        ext.max_dti_shell_value = params.dti_max_shell_value
        ext.b0_thr_extract_b0 = params.dwi_b0_threshold
        ext.dti_shells = params.dti_shells

        // ** DTI metrics to output ** //
        ext.ad = true
        ext.rd = true
        ext.md = true
        ext.fa = true
        ext.ga = true
        ext.evecs = true
        ext.evals = true
        ext.rgb = true
        ext.mode = true
        ext.norm = true
        ext.tensor = true
        ext.nonphysical = true
        ext.pulsation = true
        ext.residual = true

        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def ses = meta.session ? "${meta.session}_" : ""
                if ( filename.contains("ad.nii.gz") ) { "${meta.id}_${ses}model-tensor_param-ad_desc-fwc_dwimap.nii.gz" }
                else if ( filename.contains("fa.nii.gz") ) { "${meta.id}_${ses}model-tensor_param-fa_desc-fwc_dwimap.nii.gz" }
                else if ( filename.contains("rd.nii.gz") ) { "${meta.id}_${ses}model-tensor_param-rd_desc-fwc_dwimap.nii.gz" }
                else if ( filename.contains("md.nii.gz") ) { "${meta.id}_${ses}model-tensor_param-md_desc-fwc_dwimap.nii.gz" }
                else if ( filename.contains("mode.nii.gz") ) { "${meta.id}_${ses}model-tensor_param-mode_desc-fwc_dwimap.nii.gz" }
                else if ( filename.contains("tensor.nii.gz") ) { "${meta.id}_${ses}model-tensor_param-diffusivity_desc-fwc_dwimap.nii.gz" }
                else if ( filename.contains("rgb.nii.gz") ) { "${meta.id}_${ses}model-tensor_param-rgb_desc-fwc_dwimap.nii.gz" }
                else if ( filename.contains("ga.nii.gz") ) { "${meta.id}_${ses}model-tensor_param-ga_desc-fwc_dwimap.nii.gz" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.lean_output ? null : filename }
            }
        ]
    }
}
